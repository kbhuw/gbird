# Server
# GBIRD_PORT=8780
# GBIRD_BASE_URL=https://traces.example.com     # public URL baked into install links/hook configs
# GBIRD_ADMIN_TOKEN=                            # enables POST /api/members

# Store location (default ~/.gbird)
# GBIRD_DIR=

# Hook side (what the server-generated hooks config bakes in for each member)
# GBIRD_ENDPOINT=http://localhost:8780
# GBIRD_TOKEN=gbird_...
# GBIRD_AGENT=devin
# GBIRD_REPO=                                  # fallback ship target: push session files to a git repo via gh

# Devin pull (backfill): npm run secret:save stores these via @puffle/secret-valet
DEVIN_API_KEY=
DEVIN_ORG_ID=
# DEVIN_SYNC_LIMIT=50

# Codex pull (backfill): rollout roots (default ~/.codex/sessions + archived_sessions)
# CODEX_SESSIONS_ROOT=
# CODEX_SYNC_LIMIT=50

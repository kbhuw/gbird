# Devin ingestion — `npm run secret:save` fetches these via @puffle/secret-valet
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Optional: override the Devin API base (tests / proxies)
# DEVIN_API_BASE_URL=

# Optional: override Codex rollout roots (default ~/.codex/sessions + ~/.codex/archived_sessions)
# CODEX_SESSIONS_ROOT=

# Optional: store location (default ~/.gbird)
# GBIRD_DIR=

# Optional: per-source pull limits (default 50; use --all for everything)
# DEVIN_SYNC_LIMIT=50
# CODEX_SYNC_LIMIT=50

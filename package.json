{
  "name": "gbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "node --import tsx src/cli.ts serve --demo",
    "start": "node dist/src/cli.js serve",
    "start:secure": "npx -y @puffle/secret-valet exec devin/timeline -- node dist/src/cli.js serve",
    "sync": "node --import tsx src/cli.ts sync",
    "sync:codex": "node --import tsx src/cli.ts sync-codex",
    "sync:secure": "npx -y @puffle/secret-valet exec devin/timeline -- node --import tsx src/cli.ts sync",
    "secret:save": "npx -y @puffle/secret-valet prompt devin/timeline",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

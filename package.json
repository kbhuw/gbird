{
  "name": "gbird",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "gbird": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-hook.mjs",
    "pull": "node --import tsx src/cli.ts pull",
    "pull:secure": "npx -y @puffle/secret-valet exec devin/timeline -- node --import tsx src/cli.ts pull",
    "list": "node --import tsx src/cli.ts list",
    "secret:save": "npx -y @puffle/secret-valet prompt devin/timeline",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_schema_version", "session_id", "repo", "outcome", "coverage", "insights", "totals"],
  "properties": {
    "analysis_schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "repo": { "type": ["string", "null"] },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidence_event_ids"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "partial", "failed", "abandoned", "unknown"] },
        "summary": { "type": "string" },
        "evidence_event_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events_total", "events_reviewed", "events_with_token_usage", "events_with_timing", "limitations"],
      "properties": {
        "events_total": { "type": "integer", "minimum": 0 },
        "events_reviewed": { "type": "integer", "minimum": 0 },
        "events_with_token_usage": { "type": "integer", "minimum": 0 },
        "events_with_timing": { "type": "integer", "minimum": 0 },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "severity", "confidence", "observed", "why_it_matters", "evidence", "waste", "hypothesis", "counterevidence", "replay"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "observed": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_id", "occurred_at", "kind", "summary"],
              "properties": {
                "event_id": { "type": "string" },
                "occurred_at": { "type": ["string", "null"] },
                "kind": { "type": "string", "enum": ["message", "tool_call", "tool_result", "edit", "test", "review", "other"] },
                "summary": { "type": "string" }
              }
            }
          },
          "waste": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tokens", "token_measurement", "seconds", "time_measurement", "event_ids"],
            "properties": {
              "tokens": { "type": ["number", "null"], "minimum": 0 },
              "token_measurement": { "type": "string", "enum": ["exact", "lower_bound", "unavailable"] },
              "seconds": { "type": ["number", "null"], "minimum": 0 },
              "time_measurement": { "type": "string", "enum": ["exact", "elapsed_span", "lower_bound", "unavailable"] },
              "event_ids": { "type": "array", "items": { "type": "string" } }
            }
          },
          "hypothesis": { "type": "string" },
          "counterevidence": { "type": "array", "items": { "type": "string" } },
          "replay": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["task", "setup", "failure_condition", "success_condition"],
                "properties": {
                  "task": { "type": "string" },
                  "setup": { "type": "array", "items": { "type": "string" } },
                  "failure_condition": { "type": "string" },
                  "success_condition": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wasted_tokens", "token_measurement", "wasted_seconds", "time_measurement", "notes"],
      "properties": {
        "wasted_tokens": { "type": ["number", "null"], "minimum": 0 },
        "token_measurement": { "type": "string", "enum": ["exact", "lower_bound", "unavailable"] },
        "wasted_seconds": { "type": ["number", "null"], "minimum": 0 },
        "time_measurement": { "type": "string", "enum": ["exact", "elapsed_span", "lower_bound", "unavailable"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
